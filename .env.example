# ========================================================
# SilaiBook Environment Configuration
# Put real secrets in .env.local (never commit .env.local)
# ========================================================

# Supabase Project URL (From: Supabase Project Settings -> API)
NEXT_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co

# Supabase Public Anon Key (Safe for browser / client-side)
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key-here

# Supabase Service Role Secret Key (Server-side ONLY - Keep secret!)
# Used for administrative actions, auth bypass, and migrations
SUPABASE_SERVICE_ROLE_KEY=your-service-role-secret-key-here
